# WorldFin ingestion worker — multi-stage, non-root (Phase 10).
# Heavier than the api image: it needs the full finscrape brain (scrapling engine,
# feedparser, yfinance, spacy). The build stage carries the compilers + dev headers;
# the runtime stage keeps only the venv + the spacy model, so build tools don't ship.
FROM python:3.13-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libxml2-dev libxslt1-dev \
    && rm -rf /var/lib/apt/lists/*
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir asyncpg "pydantic>=2.6" "pydantic-settings>=2.2" \
       "apscheduler>=3.10" "prometheus-client>=0.20"
# Optional but recommended for full NER; the worker degrades gracefully without it.
RUN python -m spacy download en_core_web_sm || true

FROM python:3.13-slim
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
# Runtime needs the shared libs lxml/curl_cffi link against (not the -dev headers).
RUN apt-get update && apt-get install -y --no-install-recommends \
    libxml2 libxslt1.1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /opt/venv /opt/venv

RUN useradd --create-home --uid 10001 app
WORKDIR /app
COPY finscrape/ ./finscrape/
COPY server/ ./server/
COPY worker/ ./worker/
USER app

EXPOSE 9100
CMD ["python", "-m", "worker.main"]
