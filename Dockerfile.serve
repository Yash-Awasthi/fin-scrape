# WorldFin local-API server: API + prebuilt SPA in one image.
# Build the SPA first (npm --prefix web run build), then:
#   docker build -f Dockerfile.serve -t worldfin .
FROM python:3.12-slim

WORKDIR /app

# deps first for layer caching
COPY pyproject.toml requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt fastapi "uvicorn[standard]" \
    yfinance requests feedparser python-dotenv lxml cssselect orjson w3lib \
    curl-cffi browserforge trafilatura scipy

# app code + prebuilt frontend
COPY finscrape ./finscrape
COPY web/dist ./web/dist
COPY scripts ./scripts

ENV FINSCRAPE_MAX_AGE_HOURS=72
EXPOSE 8080
VOLUME ["/app/data"]

CMD ["python", "-m", "uvicorn", "finscrape.serve:app", "--host", "0.0.0.0", "--port", "8080"]
