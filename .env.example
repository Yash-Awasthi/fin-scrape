# ============================================================
# FinScrape Configuration
# ============================================================
# Copy to .env and fill in your values.
# All settings have sensible defaults — only API keys are required.

# --- AI Backend (pick one) ---

# Option 1: OpenRouter (recommended for production)
OPENROUTER_API_KEY=your_openrouter_key_here

# Option 2: OpenAI-compatible proxy (local dev)
# OPENAI_BASE_URL=http://localhost:8080/v1
# OPENAI_API_KEY=proxy

# LLM model (default: auto for proxy, deepseek/deepseek-chat for OpenRouter)
# FINSCRAPE_MODEL=auto

# --- AI Parameters ---
# FINSCRAPE_AI_TEMP=0.1
# FINSCRAPE_AI_MAX_TOKENS=400
# FINSCRAPE_AI_TIMEOUT=60

# --- Scraping ---
# FINSCRAPE_MAX_ARTICLES=10          # Per source
# FINSCRAPE_MAX_AGE_HOURS=24.0       # Skip articles older than this
# FINSCRAPE_MAX_PARAGRAPHS=25        # Max paragraphs to extract per article
# FINSCRAPE_MAX_WORDS=700            # Max words per article text
# FINSCRAPE_MIN_TEXT_LENGTH=150      # Skip articles shorter than this

# --- Verdict Thresholds ---
# FINSCRAPE_INVEST_THRESHOLD=3       # Score >= 3 → INVEST
# FINSCRAPE_OBSERVE_THRESHOLD=1      # Score >= 1 → OBSERVE
# FINSCRAPE_CAUTIOUS_THRESHOLD=-1    # Score >= -1 → CAUTIOUS (else PULL_OUT)

# --- Deduplication ---
# FINSCRAPE_DEDUP_SIMILARITY=0.85    # Headline similarity threshold
# FINSCRAPE_DEDUP_OVERLAP=0.5        # Ticker overlap ratio
# FINSCRAPE_DIVERGENCE_PENALTY=0.15  # Confidence penalty when AI/heuristics disagree

# --- Storage ---
# FINSCRAPE_DATA_DIR=                # Default: data/ in project root

# --- Custom RSS Feeds (comma-separated) ---
# FINSCRAPE_RSS_FEEDS=https://example.com/feed1.xml,https://example.com/feed2.xml
