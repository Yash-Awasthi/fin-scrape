# WorldFin API image (Phase 0). Multi-stage hardening (non-root, slim) is Phase 10;
# this is the minimal correct version that boots the FastAPI app.
FROM python:3.13-slim

WORKDIR /app

# Server deps only — the finscrape brain is importable from the mounted source.
# Keeping this list explicit (not the full finscrape extras) keeps the image lean.
RUN pip install --no-cache-dir \
    "fastapi>=0.110" \
    "uvicorn[standard]>=0.29" \
    "asyncpg>=0.29" \
    "pydantic>=2.6" \
    "pydantic-settings>=2.2"

COPY server/ ./server/
COPY finscrape/ ./finscrape/

EXPOSE 8000
CMD ["python", "-m", "server.main"]
