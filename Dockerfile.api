# WorldFin API image — multi-stage, non-root, slim.
# Builder installs deps into a venv; the runtime stage copies only the venv + app,
# so build tools never ship. Server deps only (not the full finscrape extras) keep
# the image lean.
FROM python:3.13-slim AS build
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN pip install --no-cache-dir \
    "fastapi>=0.110" \
    "uvicorn[standard]>=0.29" \
    "asyncpg>=0.29" \
    "pydantic>=2.6" \
    "pydantic-settings>=2.2" \
    "prometheus-client>=0.20" \
    "requests>=2.31" \
    "python-dateutil>=2.9" \
    "feedparser>=6.0" \
    "curl-cffi>=0.7" \
    "python-dotenv>=1.0" \
    "orjson>=3.9" \
    "yfinance>=0.2.30"     "msgpack>=1.2.1"     "setuptools>=78.1.1"

FROM python:3.13-slim
# Patched OpenSSL and setuptools; the base image lags Debian's and PyPI's fixes.
RUN apt-get update && apt-get upgrade -y --no-install-recommends     && rm -rf /var/lib/apt/lists/*     && pip install --no-cache-dir --upgrade "setuptools>=78.1.1"
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
COPY --from=build /opt/venv /opt/venv

# Non-root runtime user (uid fixed so volume perms are predictable).
RUN useradd --create-home --uid 10001 app
WORKDIR /app
COPY server/ ./server/
COPY worker/ ./worker/
COPY finscrape/ ./finscrape/
USER app

EXPOSE 8000
CMD ["python", "-m", "server.main"]
