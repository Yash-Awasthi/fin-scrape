# ── Apify ───────────────────────────────────────────────
# Required for live Twitter/X scraping via the Apify platform.
# Get your token at: https://console.apify.com/account/integrations
APIFY_API_KEY=your_apify_api_key_here

# Actor to use (default is apidojo/tweet-scraper — well-maintained, rich fields)
# APIFY_TWITTER_ACTOR=apidojo/tweet-scraper

# Max tweets fetched per scheduled run (controls Apify compute cost)
# APIFY_MAX_TWEETS=100

# ── PostgreSQL ──────────────────────────────────────────
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/georisk_db

# ── Twitter / X (Twikit collector) ──────────────────────
# Required: your X account credentials used for scraping.
# Use a dedicated burner/service account — not your personal account.
TWITTER_USERNAME=your_x_username
TWITTER_PASSWORD=your_x_password

# Optional: email address (used as auth_info_2 if X prompts for it)
TWITTER_EMAIL=your_x_email@example.com

# Optional: TOTP secret for 2FA-enabled accounts
# TWITTER_TOTP_SECRET=

# Cookie file path — reused across runs to avoid repeated logins.
# Relative to backend/ directory. Created automatically on first login.
TWITTER_COOKIES_FILE=config/twitter_cookies.json

# Optional: HTTP proxy for Twikit requests
# TWITTER_PROXY=http://proxy-host:8080

# Language preference for search results
TWITTER_LANG=en-US

# Collection limits
TWITTER_MAX_TWEETS_PER_ACCOUNT=10
TWITTER_MAX_TWEETS_PER_QUERY=20

# Enable/disable collection modes independently
TWITTER_ENABLE_ACCOUNT_TIMELINES=true
TWITTER_ENABLE_SEARCH=true

# Enable the Twitter collector in the scheduler
ENABLE_TWITTER=true
