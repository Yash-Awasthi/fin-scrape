/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fin-scrape",
	"compatibility_date": "2026-02-28",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	/**
	 * Durable Objects
	 * https://developers.cloudflare.com/durable-objects/
	 */
	"durable_objects": {
		"bindings": [
			{
				"name": "SIGNALS_DO",
				"class_name": "SignalsDO"
			}
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fin-scrape-db",
			"database_id": "95eeecf5-96cc-4e2c-ad4f-e99c541dae6f",
			"migrations_dir": "migrations"
		}
	],
	"migrations": [
		{
			"tag": "v1",
			"new_classes": [
				"SignalsDO"
			]
		}
	],
	"ai": {
		"binding": "AI"
	},
	"vars": {
		"AI_VIRTUAL_MODEL": "auto",
		"API_KEY": "finscrape-default-key"
	},
	"assets": {
		"directory": "./public/",
		"binding": "ASSETS"
	}
}